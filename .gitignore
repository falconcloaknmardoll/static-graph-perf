# Dataset (large files — keep locally, not in git)
data/

# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Reference — Google's tpu_graphs repo (third-party, own LICENSE). Clone separately;
# see README "Setup". Needed only by scripts/extract_opcode_map.py.
reference/

# Papers — copyrighted PDFs (arXiv preprints, Jouppi TPU paper). Cited in README,
# not redistributed. Keep out of history so the repo is clean when it goes public.
papers/

# WandB — raw run logs (large, mostly internal state). Training curves are already
# committed as experiments/figures/*.png. Regenerate logs by re-running run_*.sh.
wandb/

# Stray notebook/editor artifacts
*.ipynb

# Personal planning / strategy docs — private, never committed
PROJECT_TIMELINE.md
*.private.md
# Meeting-prep decks — contain private planning notes; keep private so the
# repo is clean when it goes public.
meeting_prep_*.md

# Training artifacts — large binaries / regenerable logs (regenerate via run_*.sh).
# Checkpoints are model weights (100s of MB); logs are per-run text.
checkpoints/
logs/
checkpoints_*.log
